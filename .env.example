# Bot Configuration
ALCHEMY_API_KEY=your_alchemy_api_key
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLANKER_CHANNEL_ID=your_clanker_channel_id

# FID Role IDs
FID_BELOW_1000_ROLE=role_id_here
FID_BELOW_5000_ROLE=role_id_here
FID_BELOW_10000_ROLE=role_id_here

# Follower Role IDs
FOLLOWERS_OVER_5000_ROLE=role_id_here
FOLLOWERS_OVER_10000_ROLE=role_id_here
FOLLOWERS_OVER_20000_ROLE=role_id_here
FOLLOWERS_OVER_50000_ROLE=role_id_here
FOLLOWERS_OVER_100000_ROLE=role_id_here
FOLLOWERS_OVER_200000_ROLE=role_id_here

# Platform Role IDs
BANKR_DEPLOYER_ROLE=role_id_here

# Optional: Postgres, which the webapp reads. Without it the bot runs Discord-only.
DATABASE_URL=

# Optional: the webapp's public URL, for "Vet on Clank" links in Discord
WEB_URL=

# Optional: Elysium. Leave unset until Clanker's details there are public (see the README).
# ELYSIUM_CHAIN_ID=
# ELYSIUM_RPC_URL=
# ELYSIUM_WS_URL=
# ELYSIUM_EXPLORER_URL=
# ELYSIUM_FACTORY_V4=
# ELYSIUM_FACTORY_V5=
# ELYSIUM_V5_HOOK=
