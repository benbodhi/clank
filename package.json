{
  "name": "clank",
  "version": "2.0.0",
  "private": true,
  "description": "Real-time Clanker token launch tracker: Discord alerts and a live webapp",
  "scripts": {
    "bot": "pnpm --filter @clank/bot start",
    "bot:dry-run": "pnpm --filter @clank/bot dry-run",
    "backfill": "pnpm --filter @clank/bot backfill",
    "web": "pnpm --filter @clank/web dev",
    "build": "pnpm --filter @clank/web build",
    "typecheck": "pnpm --filter @clank/web typecheck",
    "test": "pnpm --recursive test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benbodhi/clank.git"
  },
  "author": {
    "name": "Benbodhi",
    "url": "https://farcaster.xyz/benbodhi"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.0"
    }
  }
}
